# Environment variables for the landing site — NAMES and PURPOSE only, never real values.
#
# Values live in the hosting provider's dashboard and in your local `.env.local`. They are
# never committed or pasted into chat: credentials are confidential and only travel through
# a secure channel. A variable belongs in this file once the code actually reads it — one
# nothing reads yet is not a startup requirement.

# Canonical site URL. The code reads it; it existed in code before it was added to this
# example file. Locally it is plain localhost; in production, the public domain.
NEXT_PUBLIC_SITE_URL=

# A donde apunta el boton que lleva a la aplicacion (el CTA de registro).
# En local, el frontend de dev; en produccion, la app publica.
NEXT_PUBLIC_APP_URL=
